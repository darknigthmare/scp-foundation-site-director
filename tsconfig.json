{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "outFile": "dist/game.js",
    "removeComments": false,
    "sourceMap": false,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true
  },
  "files": [
    "src/types.ts",
    "src/data.ts",
    "src/utils.ts",
    "src/access.ts",
    "src/site-spatial.ts",
    "src/underground-gates.ts",
    "src/underground-utilities.ts",
    "src/underground-navigation.ts",
    "src/state.ts",
    "src/simulation.ts",
    "src/renderers.ts",
    "src/ui.ts",
    "src/main.ts"
  ]
}

